{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/pdf/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/verify_payment",
      "dest": "api/index.py"
    },
    {
      "src": "/signup",
      "dest": "api/index.py"
    },
    {
      "src": "/login",
      "dest": "api/index.py"
    },
    {
      "src": "/logout",
      "dest": "api/index.py"
    },
    {
      "src": "/read/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
